# ===========================================
# Vector Store + n8n Platform Configuration
# ===========================================

# Domain Configuration
N8N_HOST=n8n.shop.co.kr
N8N_PROTOCOL=https
SITE_URL=https://n8n.shop.co.kr
API_EXTERNAL_URL=https://n8n.shop.co.kr

# Timezone
GENERIC_TIMEZONE=Asia/Seoul

# ===========================================
# PostgreSQL Configuration
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vector_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=vector_postgres_secure_password_2024!

# ===========================================
# n8n Configuration
# ===========================================
N8N_USER=admin
N8N_PASSWORD=n8n_admin_secure_2024!
N8N_DB_PASSWORD=n8n_db_secure_password_2024!
N8N_ENCRYPTION_KEY=n8n_encryption_key_must_be_32_chars_long_secure_2024
N8N_PORT=5678

# ===========================================
# Redis Configuration
# ===========================================
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_2024!

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long-secure-2024
JWT_EXPIRY=3600

# ===========================================
# Supabase Keys
# Generate these using your JWT_SECRET at https://jwt.io/
# ===========================================
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNjQxNzY5MjAwLCJleHAiOjE3OTk1MzU2MDB9.replace_with_your_anon_key
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.replace_with_your_service_key

# ===========================================
# Additional Secrets
# ===========================================
SECRET_KEY_BASE=base64_encoded_64_chars_secret_key_for_supabase_2024
VAULT_ENC_KEY=32_chars_vault_encryption_key_secure_2024!

# ===========================================
# Email Configuration (Optional)
# ===========================================
ENABLE_EMAIL_SIGNUP=false
DISABLE_SIGNUP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="Vector Platform"

# ===========================================
# Security Settings
# ===========================================
N8N_SECURE_COOKIE=true
N8N_SAMESITE_COOKIE=lax
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ===========================================
# Logging
# ===========================================
N8N_LOG_LEVEL=info
LOGFLARE_API_KEY=logflare_api_key_for_analytics